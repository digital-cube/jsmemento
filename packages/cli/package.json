{
  "name": "@jsmemento/cli",
  "version": "1.1.0",
  "description": "JSMemento CLI: setup, tenants, API keys, templates, chats, lookups and a live tail.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsmemento.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/digital-cube/jsmemento#readme",
  "bugs": "https://github.com/digital-cube/jsmemento/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "memento": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@jsmemento/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --conditions=@jsmemento/source src/main.ts",
    "test": "vitest run",
    "test:pg": "MEMENTO_TEST_DIALECT=postgres vitest run",
    "test:sqlite": "MEMENTO_TEST_DIALECT=sqlite vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@jsmemento/core": "workspace:*",
    "@jsmemento/lookups": "workspace:*",
    "@jsmemento/server": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
