{
  "name": "@memento/cli",
  "version": "0.1.0",
  "description": "JSMemento CLI: setup, tenants, API keys, templates, chats, lookups and a live tail.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "memento": "./dist/main.js"
  },
  "exports": {
    ".": {
      "@memento/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx --conditions=@memento/source src/main.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "@memento/core": "workspace:*",
    "@memento/lookups": "workspace:*",
    "@memento/server": "workspace:*",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  }
}
