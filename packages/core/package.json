{
  "name": "@memento/core",
  "version": "1.0.0",
  "description": "JSMemento protocol: Zod schemas, inferred types and helpers shared by server, CLI and clients.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsmemento.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/digital-cube/jsmemento#readme",
  "bugs": "https://github.com/digital-cube/jsmemento/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@memento/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
