{
  "name": "@memento/server",
  "version": "1.0.0",
  "description": "JSMemento server: Fastify app, Drizzle/PostgreSQL storage, tenant isolation, API key auth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-cube/jsmemento.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/digital-cube/jsmemento#readme",
  "bugs": "https://github.com/digital-cube/jsmemento/issues",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "@memento/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "templates"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@memento/source src/server.ts",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@memento/source src/migrate-cli.ts",
    "db:migrate:test": "MIGRATE_TARGET=test tsx --conditions=@memento/source src/migrate-cli.ts",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@jsudc/core": "0.2.0",
    "@jsudc/server": "0.2.1",
    "@memento/core": "workspace:*",
    "@memento/lookups": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
