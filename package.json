{
  "name": "jsmemento",
  "private": true,
  "type": "module",
  "description": "JSMemento — self-hosted activity ledger (monorepo: @memento/core, @memento/server, @memento/cli)",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:coverage": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev": "pnpm --filter @memento/server dev",
    "db:up": "docker compose up -d postgres redis",
    "db:generate": "pnpm --filter @memento/server db:generate",
    "db:migrate": "pnpm --filter @memento/server db:migrate",
    "db:migrate:test": "pnpm --filter @memento/server db:migrate:test",
    "memento": "pnpm --filter @memento/cli exec tsx src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "version": "1.0.0"
}
