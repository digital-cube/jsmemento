# Copy to `.env` (or `.env.local`) and fill in. Every variable is optional: the same values
# can be typed into the settings of the page (they are then kept in localStorage), and a
# server with MEMENTO_DEMO_API_KEY hands the page its demo key by itself.

# Pre-fills the API key (development convenience): a key of the tenant the monitor pushes
# to, with the read scope.
#   pnpm memento create-key --tenant demo --scopes read --name examples-ui
VITE_MEMENTO_API_KEY=
# The UDC collection the sidebar is drawn from. Default: menu.
VITE_MENU_COLLECTION=

# Where the dev server proxies /memento (HTTP and WebSocket). Default http://localhost:8000.
MEMENTO_SERVER=http://localhost:8000
