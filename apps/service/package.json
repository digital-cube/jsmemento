{
  "name": "@memento/service",
  "version": "1.0.0",
  "private": true,
  "description": "The memento service site (https://service.stage.memento-service.org/): register, sign in, create and manage API keys, watch what each key writes. On @jsudc/react with the session cookie; served by a second @memento/server container from MEMENTO_UI_DIR=/app/ui-service.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@jsudc/core": "0.2.0",
    "@jsudc/react": "0.2.1",
    "@memento/core": "workspace:*",
    "@memento/react": "workspace:*",
    "@memento/ui-shell": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^8.21.3",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "shiki": "^4.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
