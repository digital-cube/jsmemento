# Copy to `.env` (or `.env.local`) and fill in. Every variable is optional: the same values
# can be typed into the settings bar of the page (they are then kept in localStorage).

# Pre-fills the API key: a key of the tenant the monitor pushes to, with the read scope.
#   pnpm memento create-key --tenant demo --scopes read --name cpu-monitor-ui
VITE_MEMENTO_API_KEY=

# Where the dev server proxies /memento (HTTP and WebSocket). Default http://localhost:8000.
MEMENTO_SERVER=http://localhost:8000
