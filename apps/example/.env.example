# Copy to `.env` (or `.env.local`) and fill in. Every variable is optional.

# Pre-fills the key field: a key with read (and write, to send messages and test events).
#   pnpm memento create-key --tenant acme --scopes read,write --name example-app
VITE_MEMENTO_API_KEY=

# Where the dev server proxies /memento (HTTP and WebSocket). Default http://localhost:8000.
MEMENTO_SERVER=http://localhost:8000

# Chat the Chat tab opens, and who you are in it (must be a participant).
VITE_MEMENTO_CHAT_ID=
VITE_MEMENTO_USER_ID=
