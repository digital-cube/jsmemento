{
  "name": "@memento/website",
  "version": "1.0.0",
  "private": true,
  "description": "memento-service.org: the website of memento (Astro + Starlight), static files built by deploy/website/stage.sh; not part of the Docker image.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && node scripts/check-snippets.mjs",
    "shots": "node scripts/shots.mjs",
    "capture": "node scripts/capture.mjs",
    "check:snippets": "node scripts/check-snippets.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.7",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.4",
    "sharp": "^0.35.5",
    "starlight-links-validator": "^0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@memento/core": "workspace:*",
    "@memento/react": "workspace:*",
    "@memento/server": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "fastify": "^5.12.7",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "typescript": "^5.9.3"
  }
}
