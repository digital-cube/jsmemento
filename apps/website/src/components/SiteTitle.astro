---
/*
 * The header's wordmark (Starlight's `SiteTitle` overridden): the thread mark and
 * "memento." set in the display face, as on the under-construction page. Text, not an
 * image, so it takes the site's font and the theme's colours.
 */
import logo from "../assets/logo.svg?raw";

const href = import.meta.env.BASE_URL;
---

<a {href} class="site-title" aria-label="memento, home">
  <span class="mark" aria-hidden="true" set:html={logo} />
  <span class="word" aria-hidden="true">memento<span class="dot">.</span></span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  .mark :global(svg) {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
  }
  .word {
    font-family: var(--memento-font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1;
    letter-spacing: 0.01em;
    font-variation-settings: "opsz" 28;
  }
  .dot {
    color: var(--memento-thread);
    font-style: normal;
  }
</style>
