---
/*
 * The packages with the versions of packages/*\/package.json, read when the site is built, and
 * when each one's newest version went to npm (the registry, asked by src/build-info.mjs in the
 * same build; never an error: "not on npm yet" for a 404, nothing when it did not answer). The
 * Docker image and its tags (docs/DEPLOYMENT.md), beside it the newest release tag of this build
 * and its date; the eight client programs; at the bottom the build line (BuildLine.astro).
 */
import cli from "../../../../../packages/cli/package.json";
import core from "../../../../../packages/core/package.json";
import lookups from "../../../../../packages/lookups/package.json";
import react from "../../../../../packages/react/package.json";
import server from "../../../../../packages/server/package.json";
import { buildInfo, dateOf, minuteOf } from "../../build-info.mjs";
import { REPO_URL as REPO, SERVICE_URL } from "../../site.mjs";
import BuildLine from "../BuildLine.astro";

const info = await buildInfo();
const npmOf = (name: string) => info.npm[name] ?? { state: "unknown" as const };
const { release } = info;
const packages = [
  { pkg: core, dir: "core", text: "The protocol: the event and envelope schemas, the Filter DSL, the HTTP client and MementoStream." },
  { pkg: server, dir: "server", text: "The Fastify app and plugin: storage on PostgreSQL or one SQLite file, tenants and keys, templates, /ws, UDC collections, accounts." },
  { pkg: cli, dir: "cli", text: "memento: migrations, tenants, keys, templates, chats, lookups, a live tail, the CPU monitor and the simulator." },
  { pkg: react, dir: "react", text: "MementoProvider, the live MementoDataView, MementoChat and MementoSearch." },
  { pkg: lookups, dir: "lookups", text: "The vocabulary of lookups.yaml: event, instance and actor types, translations, candidates, codegen." },
];
const tags = [
  { tag: "1.1.0, 1.1, 1, latest", from: "the release tag v1.1.0 (latest: the newest tag)" },
  { tag: "main, edge", from: "the newest commit on main" },
  { tag: "sha-<short>", from: "that commit" },
];
const clients = [
  ["JavaScript", "javascript"],
  ["TypeScript", "typescript"],
  ["Python", "python"],
  ["PHP", "php"],
  ["Java", "java"],
  ["Rust", "rust"],
  ["Go", "golang"],
  ["C++", "cpp"],
];
---

<section class="home-section pkgs not-content" aria-labelledby="packages">
  <header>
    <h2 id="packages">Five packages, one image, eight clients</h2>
    <p>
      One monorepo, one version line. Every release tag puts the packages on npm and the image on
      GitHub's registry, which also carries the image of every commit of main; the source is
      <a href={REPO}>the repository</a>.
    </p>
  </header>
  <ul class="list">
    {
      packages.map(({ pkg, dir, text }) => (
        <li>
          <a class="name" href={`${REPO}/tree/main/packages/${dir}`}>
            {pkg.name}
          </a>
          <p>{text}</p>
          <div class="ver">
            <span class="version">{pkg.version}</span>
            {(() => {
              const npm = npmOf(pkg.name);
              if (npm.state === "absent") return <span class="npm none">not on npm yet</span>;
              if (npm.state !== "published") return null;
              return (
                <span class="npm" title={`${npm.version} published on npm ${minuteOf(npm.time)}`}>
                  {npm.version !== pkg.version ? `${npm.version} on npm ` : "on npm "}
                  <time datetime={npm.time}>{dateOf(npm.time)}</time>
                </span>
              );
            })()}
          </div>
        </li>
      ))
    }
  </ul>

  <div class="more">
    <div>
      <h3>
        <a href={`${REPO}/pkgs/container/jsmemento`}>ghcr.io/digital-cube/jsmemento</a>
        {
          release?.source === "git" && (
            <span class="released" title={`the commit date of tag ${release.tag}`}>
              {release.tag} released <time datetime={release.date}>{dateOf(release.date)}</time>
            </span>
          )
        }
        {
          release?.source === "changelog" && (
            <span class="released" title={`no v${release.version} tag yet: the date of [${release.version}] in CHANGELOG.md`}>
              no release tag yet, {release.version} dated <time datetime={release.date}>{dateOf(release.date)}</time> in the changelog
            </span>
          )
        }
      </h3>
      <p>Multi-arch (amd64, arm64), with a build provenance attestation. The server, the CLI, the examples site and the service site in one image.</p>
      <table>
        <tbody>
          {
            tags.map((t) => (
              <tr>
                <td><code>{t.tag}</code></td>
                <td>{t.from}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div>
      <h3><a href={`${SERVICE_URL}/clients`}>Client programs</a></h3>
      <p>
        One complete program per language, plain HTTP and a WebSocket, no SDK:
        {
          clients.map(([label, dir], i) => (
            <>
              <a href={`${REPO}/tree/main/clients/${dir}`}>{label}</a>
              {i < clients.length - 1 ? ", " : "."}
            </>
          ))
        }
      </p>
    </div>
  </div>
  <footer class="colophon">
    <p>MIT licence.</p>
    <BuildLine />
  </footer>
</section>

<style>
  .list {
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .list li {
    display: grid;
    gap: 0.4rem 2rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-top: 1px solid var(--memento-rule);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--memento-rule);
  }
  .name {
    font: 500 1rem var(--sl-font-mono);
    color: var(--sl-color-white) !important;
    text-decoration: none;
  }
  .name:hover {
    color: var(--sl-color-text-accent) !important;
  }
  .list p {
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
  }
  .ver {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0.9rem;
    align-items: baseline;
  }
  .version,
  .npm {
    font: 0.8125rem var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
  .released {
    display: block;
    margin-top: 0.3rem;
    font: 0.75rem var(--sl-font-mono);
    color: var(--sl-color-gray-3);
  }
  .more {
    display: grid;
    gap: 2rem 3.5rem;
    margin-top: 2.5rem;
  }
  .more h3 {
    font: 500 1rem var(--sl-font-mono);
    margin-bottom: 0.5rem;
  }
  .more p {
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
  }
  table {
    margin-top: 0.75rem;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  td {
    padding: 0.4rem 1rem 0.4rem 0;
    border-bottom: 1px solid var(--memento-rule);
    color: var(--sl-color-gray-2);
  }
  .colophon {
    display: grid;
    gap: 0.35rem;
    margin-top: 2rem;
  }
  .colophon p {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
  @media (min-width: 50rem) {
    .list li {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
    }
    .ver {
      flex-direction: column;
      align-items: flex-end;
    }
    .more {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
