---
/*
 * The examples, live: the eight pages of the examples site (menu.yaml's EXAMPLES, in its order)
 * as real screenshots, taken by scripts/shots.mjs (npm run shots) into src/assets/examples.
 * The names above the strip are links to the frames; with JS they scroll the strip instead of
 * the page. A page with a <name>-dark.webp shows it in the dark theme; until the examples site
 * has a dark theme of its own there is none, and the light shot stands in both themes.
 */
import { Image } from "astro:assets";
import { EXAMPLE_URL } from "../../site.mjs";

const shots = import.meta.glob<{ default: ImageMetadata }>("../../assets/examples/*.webp", {
  eager: true,
});
const shot = (name: string, theme: "light" | "dark") =>
  shots[`../../assets/examples/${name}-${theme}.webp`]?.default;

const pages = [
  {
    name: "cpu-monitor",
    label: "CPU monitor",
    route: "/examples/cpu-monitor",
    text: "The CLI pushes this machine's load every second; the cpu_load UDC collection draws it as a live table and chart.",
    alt: "A live table of CPU_LOAD samples of server/stage, with the stream's Live badge",
  },
  {
    name: "activity",
    label: "Activity feed",
    route: "/examples/activity",
    text: "Every event of the tenant as the sentence memento rendered, newest on top, in the header's language.",
    alt: "A feed of rendered sentences: notes, ticket changes and chat messages with avatars",
  },
  {
    name: "entity",
    label: "Entity timeline",
    route: "/examples/entity",
    text: "What happened to one ticket: its create, modify, note and close story, read through UDC, live.",
    alt: "The timeline of one ticket: its notes, modifications, creation and closing, newest on top",
  },
  {
    name: "chat",
    label: "Chat",
    route: "/examples/chat",
    text: "The simulator's demo room in MementoChat, seen as one participant, with who has read what.",
    alt: "A chat room with messages in English and Serbian and Seen by markers",
  },
  {
    name: "tail",
    label: "Live tail",
    route: "/examples/tail",
    text: "Every frame of /memento/ws as it arrives, with the stream's filters in the URL: memento tail in the browser.",
    alt: "Raw WebSocket frames, one line per event, under the stream's filter form",
  },
  {
    name: "search",
    label: "Search",
    route: "/examples/search",
    text: "MementoSearch next to the Filter DSL JSON it sends to POST /events/query, and the request as curl.",
    alt: "A search form and its results next to the Filter DSL, the curl request and the response",
  },
  {
    name: "rendering",
    label: "Rendering & translations",
    route: "/examples/rendering",
    text: "One event, its bundled EN and SR templates, and the sentence the server renders from each.",
    alt: "A TICKET_CLOSED event with its English and Serbian templates and the two rendered sentences",
  },
  {
    name: "chart",
    label: "Activity chart",
    route: "/examples/chart",
    text: "Events per minute by type, counted by the server (the activity collection), drawn by the chart renderer.",
    alt: "A line chart of events per minute per event type over the last hour",
  },
].map((p) => {
  const light = shot(p.name, "light");
  if (!light) throw new Error(`no screenshot ${p.name}-light.webp; run npm run shots`);
  return { ...p, light, dark: shot(p.name, "dark") };
});
---

<section class="home-section strip-section not-content" aria-labelledby="examples-live">
  <header>
    <h2 id="examples-live">The examples, live</h2>
    <p>
      Real screenshots of the <a href={EXAMPLE_URL}>examples site</a>: eight pages over one
      tenant that a CPU monitor and a ticket desk simulator keep writing to. Every list on them is a
      UDC collection; every page follows the live stream.
    </p>
  </header>
  <nav class="names" aria-label="Examples">
    {
      pages.map((p, i) => (
        <a href={`#shot-${p.name}`} aria-current={i === 0 ? "true" : undefined}>
          {p.label}
        </a>
      ))
    }
  </nav>
  <ol class="strip" data-strip>
    {
      pages.map((p, i) => (
        <li id={`shot-${p.name}`} class="frame">
          <figure>
            <a class="shot" href={EXAMPLE_URL + p.route} tabindex="-1">
              {p.dark ? (
                <>
                  <Image src={p.light} alt={p.alt} widths={[720, 1440]} sizes="(min-width: 50rem) 720px, 88vw" loading={i < 2 ? "eager" : "lazy"} class="light" />
                  <Image src={p.dark} alt={p.alt} widths={[720, 1440]} sizes="(min-width: 50rem) 720px, 88vw" loading={i < 2 ? "eager" : "lazy"} class="dark" />
                </>
              ) : (
                <Image src={p.light} alt={p.alt} widths={[720, 1440]} sizes="(min-width: 50rem) 720px, 88vw" loading={i < 2 ? "eager" : "lazy"} />
              )}
            </a>
            <figcaption>
              <p class="title">
                <b>{p.label}</b>
                <a href={EXAMPLE_URL + p.route}>{p.route}</a>
              </p>
              <p>{p.text}</p>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ol>
</section>

<script>
  for (const section of document.querySelectorAll(".strip-section")) {
    const strip = section.querySelector<HTMLElement>("[data-strip]");
    const links = [...section.querySelectorAll<HTMLAnchorElement>(".names a")];
    if (!strip) continue;
    const select = (id: string) => {
      for (const a of links) a.toggleAttribute("aria-current", a.hash === `#${id}`);
    };
    for (const a of links) {
      a.addEventListener("click", (e) => {
        const frame = strip.querySelector<HTMLElement>(a.hash);
        if (!frame) return;
        e.preventDefault();
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        strip.scrollTo({ left: frame.offsetLeft - strip.offsetLeft, behavior: reduce ? "auto" : "smooth" });
        select(frame.id);
      });
    }
    // The name of the frame at the strip's start follows a manual scroll.
    const seen = new IntersectionObserver(
      (entries) => {
        const first = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.left - b.boundingClientRect.left)[0];
        if (first) select(first.target.id);
      },
      { root: strip, threshold: 0.6 },
    );
    for (const li of strip.children) seen.observe(li);
  }
</script>

<style>
  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.25rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--memento-rule);
    border-radius: 4px;
  }
  .names a {
    padding: 0.35rem 0.7rem;
    border-radius: 3px;
    font-size: 0.875rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .names a:hover {
    color: var(--sl-color-white);
  }
  .names a[aria-current] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
    box-shadow: inset 0 -2px 0 var(--memento-thread);
  }
  .strip {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0 0 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    scrollbar-color: var(--memento-rule) transparent;
  }
  .frame {
    flex: 0 0 min(88vw, 45rem);
    scroll-snap-align: start;
  }
  figure {
    margin: 0;
  }
  .shot {
    display: block;
    border: 1px solid var(--memento-rule);
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--memento-surface-raised);
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  :global([data-theme="light"]) .shot img.dark,
  :global(:root:not([data-theme="light"])) .shot img.light {
    display: none;
  }
  figcaption {
    margin-top: 0.875rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .title {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.25rem;
  }
  .title b {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .title a {
    font: 0.78rem var(--sl-font-mono);
  }
</style>
