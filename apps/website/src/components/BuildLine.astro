---
/*
 * One quiet mono line in the footer of every page: on the home page beside "MIT licence."
 * (home/Packages.astro), on the docs pages under Starlight's footer (DocsFooter.astro). The
 * version, when it was released, when this site was built, the commit. All of it from
 * src/build-info.mjs, once per build. A part the build could not know is left out.
 */
import { buildInfo, dateOf, minuteOf } from "../build-info.mjs";
import { REPO_URL } from "../site.mjs";

const { version, release, builtAt, commit } = await buildInfo();
// The tag named only when it is not this version's (a version bumped, not released yet).
const releaseTag = release && release.version !== version ? (release.tag ?? `v${release.version}`) : null;
const releaseTitle = release
  ? release.source === "git"
    ? `the commit date of tag ${release.tag}`
    : `the date of [${release.version}] in CHANGELOG.md (no release tag yet)`
  : undefined;
---

<p class="build-line" data-pagefind-ignore>
  <span>v{version}</span>
  {
    release && (
      <span title={releaseTitle}>
        {releaseTag ? `${releaseTag} released ` : "released "}
        <time datetime={release.date}>{dateOf(release.date)}</time>
      </span>
    )
  }
  <span>built <time datetime={builtAt}>{minuteOf(builtAt)}</time></span>
  {
    commit && (
      <span>
        <a href={`${REPO_URL}/commit/${commit.full}`} title={`commit ${commit.full}`}>{commit.short}</a>
      </span>
    )
  }
</p>

<style>
  .build-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 0;
    margin: 0;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--sl-color-gray-3);
  }
  /* Each part keeps its words together; on a narrow screen the line wraps between parts. */
  span:not(:last-child)::after {
    content: "·";
    padding-inline: 0.55em;
  }
  span {
    white-space: nowrap;
  }
  /* p.build-line a[href]: Astro scopes with :where(), and the home page's
     `.home-section a:not(.sl-link-button)` (theme.css) would win otherwise. */
  p.build-line a[href] {
    color: var(--sl-color-gray-3);
    text-decoration: underline;
    text-decoration-color: var(--memento-rule);
    text-underline-offset: 0.2em;
  }
  p.build-line a[href]:hover {
    color: var(--sl-color-white);
  }
</style>
