{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "REDIS_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@memento/cli#test": {
      "dependsOn": ["^build", "@memento/server#test"],
      "outputs": [],
      "cache": false
    },
    "@memento/cli#test:cov": {
      "dependsOn": ["^build", "@memento/server#test:cov"],
      "outputs": ["coverage/**"],
      "cache": false
    }
  }
}
