{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "MEMENTO_E2E_URL",
    "MEMENTO_E2E_DATABASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@jsmemento/cli#test": {
      "dependsOn": ["^build", "@jsmemento/server#test"],
      "outputs": [],
      "cache": false
    },
    "@jsmemento/cli#test:cov": {
      "dependsOn": ["^build", "@jsmemento/server#test:cov"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}
