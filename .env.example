# --- JSMemento environment ---------------------------------------------------
# Copy to `.env` and adjust. Every variable below is read by @memento/server
# (and by @memento/cli, which talks to the same database).

# PostgreSQL connection used by the server, the CLI and `pnpm db:migrate`.
DATABASE_URL=postgresql://jsmemento:jsmemento@localhost:5432/jsmemento
# Separate database the test suites run against (truncated on every test file).
TEST_DATABASE_URL=postgresql://jsmemento:jsmemento@localhost:5432/jsmemento_test

# Redis used to publish every stored event (channel `memento:events:<tenant_slug>`) and,
# by the WebSocket stream `/memento/ws`, to receive what any server process stored.
# Leave empty to run one process without Redis: events are streamed in memory.
REDIS_URL=redis://localhost:6379/0
# Prefix of the Redis pub/sub channel names.
REDIS_CHANNEL_PREFIX=memento:events

# HTTP listener of the standalone server (`pnpm dev`; the Docker image sets PORT=3000).
HOST=0.0.0.0
PORT=8000
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Path prefix all memento routes are mounted under.
MEMENTO_API_PREFIX=/memento

# --- WebSocket stream (/memento/ws) ----------------------------------------------
# Ping interval; a client that does not answer one ping in time is disconnected.
MEMENTO_WS_HEARTBEAT_MS=30000
# Unwritten messages a connection may pile up before it is dropped as a slow consumer.
MEMENTO_WS_MAX_BUFFERED=1000

# --- Templates & lookups (docs/TEMPLATES.md) -----------------------------------
# Locale events are rendered in when a request has no ?locale (last step of every chain).
MEMENTO_DEFAULT_LOCALE=en
# Vocabulary file; default: lookups.yaml at the repository root.
MEMENTO_LOOKUPS_PATH=
# Label sheet; default: i18n/translations.csv next to lookups.yaml.
MEMENTO_TRANSLATIONS_PATH=
# Where unknown lookup values are recorded; default: var/candidates next to lookups.yaml.
MEMENTO_CANDIDATES_DIR=
MEMENTO_RECORD_CANDIDATES=true
# true: reject events whose event/instance/actor type is not in lookups.yaml.
MEMENTO_LOOKUPS_STRICT=false

# --- CLI ----------------------------------------------------------------------
# Default tenant of `memento create-chat` / `send-message` when --tenant is omitted.
MEMENTO_TENANT=

# --- compose.yaml only --------------------------------------------------------
POSTGRES_USER=jsmemento
POSTGRES_PASSWORD=jsmemento
POSTGRES_DB=jsmemento
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- CLI: `memento tail` (talks to a running server, not to the database) ---------
# Server API base URL and a key with the read scope.
MEMENTO_URL=http://localhost:8000/memento
MEMENTO_API_KEY=
# Print stack traces of unexpected CLI errors.
# MEMENTO_DEBUG=1
