# Once a day (03:30 UTC, give or take 15 min), memento-prod-retention.service. Persistent=: a
# run missed while the VM was down happens at the next boot.
# Installed by deploy/examples/prod.sh as a symlink in ~/.config/systemd/user/ and enabled.
# Next run: systemctl --user list-timers memento-prod-retention.timer
[Unit]
Description=Daily memento retention for the memento-service.org sites

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
