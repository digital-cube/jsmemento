# Once a day (02:30 UTC, give or take 15 min; an hour before memento-prod-retention.timer, so
# the two do not run at once), memento-prod-backup.service. Persistent=: a run missed while the
# VM was down happens at the next boot.
# Installed by deploy/examples/prod.sh as a symlink in ~/.config/systemd/user/ and enabled.
# Next run: systemctl --user list-timers memento-prod-backup.timer
[Unit]
Description=Daily memento database backup for the memento-service.org sites

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
